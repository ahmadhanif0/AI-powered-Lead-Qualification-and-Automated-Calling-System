# ============================================================
# AI Lead Qualification System — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── JWT / Auth ────────────────────────────────────────────────────────
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres"

# ── Redis / Celery ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── HubSpot OAuth (replaces HUBSPOT_ACCESS_TOKEN) ────────────────────
# 1. Go to https://developers.hubspot.com → Create Public App → Legacy App
# 2. Set Redirect URL to: http://localhost:8000/crm/hubspot/callback
# 3. Add scopes: crm.objects.contacts.read/write, crm.schemas.contacts.read
# 4. Copy Client ID and Client Secret below
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:8000/crm/hubspot/callback

# DEPRECATED — only needed if you still use the old private-app token path.
# Remove once all users have migrated to OAuth.
# HUBSPOT_ACCESS_TOKEN=pat-na2-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── VAPI ──────────────────────────────────────────────────────────────
VAPI_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAPI_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAPI_PHONE_NUMBER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Twilio ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public URL that Twilio can reach (use ngrok in development)
TWILIO_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/twilio/voice

# ── Server ────────────────────────────────────────────────────────────
SERVER_URL=https://your-ngrok-url.ngrok.io

# ── Email Notifications ───────────────────────────────────────────────
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASSWORD=your-app-password-here
NOTIFICATION_EMAIL_FROM=your-sending-address@gmail.com
NOTIFICATION_EMAIL_TO=sales@yourcompany.com
DASHBOARD_URL=http://localhost:5173

# ── App ───────────────────────────────────────────────────────────────
APP_NAME="AI Lead Qualification System"
